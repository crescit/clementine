# ClearPath Compliance Review — environment variables
# Copy to .env (gitignored) or export these in your shell.
#
#   export DATABASE_PATH=./data/clearpath.db
#   export DEMO_MODE=true
#   export PORT=8000

# Path to the SQLite database file (default: ./data/clearpath.db)
DATABASE_PATH=./data/clearpath.db

# When true, fresh DBs are seeded and /api/demo/reset is available.
# When false, reset and automatic demo seeding are disabled.
# This is not production auth — it only controls demo tooling.
DEMO_MODE=true

# Listen port (honored by Docker start and hosting platforms; default 8000)
PORT=8000

# A .env file in the working directory is loaded automatically at import
# (real environment variables win). Override the path with CLEARPATH_ENV_FILE,
# disable with CLEARPATH_DOTENV=0.

# Semantic review (OpenAI-compatible chat endpoint). The API key is set only
# in your private .env or real environment, never in this file.
CLEARPATH_SEMANTIC_MODE=false
CLEARPATH_INFERENCE_BASE_URL=http://localhost:8000/v1
CLEARPATH_INFERENCE_MODEL=deepseek-v4-flash
CLEARPATH_INFERENCE_TIMEOUT_S=150
